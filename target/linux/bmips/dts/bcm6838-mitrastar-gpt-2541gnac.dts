#include "bcm6838.dtsi"

/ {
	model = "Mitrastar GPT-2541GNAC";
	compatible = "mitrastar,gpt-2541gnac", "brcm,bcm6838";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x08000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Runner (RDP) multicast and traffic manager DDR, same as stock */
		rdp_mc: rdp-mc@6200000 {
			reg = <0x06200000 0x00400000>;
			no-map;
		};

		rdp_tm: rdp-tm@6600000 {
			reg = <0x06600000 0x01900000>;
			no-map;
		};
	};

#if 0
	aliases {
		led-boot = &led_power_green;
		led-failsafe = &led_power_green;
		led-running = &led_power_green;
		led-upgrade = &led_power_green;
	};
	
	
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		wps {
			label = "wps";
			gpios = <&gpio 24 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};

		wlan {
			label = "wlan";
			gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WLAN>;
			debounce-interval = <60>;
		};

		reset {
			label = "reset";
			gpios = <&gpio 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	bcm432217-sprom {
		compatible = "brcm,bcma-sprom";

		pci-bus = <1>;
		pci-dev = <0>;

		nvmem-cells = <&macaddr_cferom_6a0 1>;
		nvmem-cell-names = "mac-address";

		brcm,sprom = "brcm/bcm43217-sprom.bin";
		brcm,sprom-fixups = <6 0x1c00>,
				    <65 0x1256>,
				    <96 0x2046>,
				    <97 0xfe69>,
				    <98 0x1726>,
				    <99 0xfa5c>,
				    <112 0x2046>,
				    <113 0xfea8>,
				    <114 0x1978>,
				    <115 0xfa26>,
				    <161 0x2222>,
				    <169 0x2222>,
				    <171 0x2222>,
				    <173 0x2222>,
				    <174 0x4444>,
				    <175 0x2222>,
				    <176 0x4444>;
	};
#endif
};

&nflash {
	status = "okay";

	nandcs@0 {
		compatible = "brcm,nandcs";
		reg = <0>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <4>;
		/* stock CFE: 16 OOB bytes per 512 byte step, BCH-4 */
		brcm,nand-oob-sector-size = <16>;
		/*
		 * No nand-on-flash-bbt: the CFE keeps its own BBT in the last
		 * blocks, Linux only reads the bad block markers.
		 */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * Broadcom dual image layout. The stock firmware (image B) has
			 * been removed: OpenWrt boots from image A, and its UBI also
			 * takes the space of the old image B (bootfs + rootfs). CFE only
			 * looks at the JFFS2 bootfs of image A for cferam + kernel.
			 */
			partition@0 {
				label = "cfe";
				reg = <0x0000000 0x0020000>;
				read-only;
			};

			/* JFFS2 with cferam + vmlinux.lz4, "BcmFs-ubifs" marker at the end */
			partition@20000 {
				label = "bootfs";
				reg = <0x0020000 0x0600000>;
			};

			partition@620000 {
				label = "ubi";
				reg = <0x0620000 0x74c0000>;
			};

			partition@7b00000 {
				label = "stock_data";
				reg = <0x7b00000 0x0400000>;
				read-only;
			};
		};
	};
};

&i2c0 {
	status = "okay";
};

&hsspi{
	status = "okay";
};

&uart0 {
	status = "okay";
};

